{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2021"],
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@xarvis/shared": ["libraries/shared/src/index.ts"],
      "@xarvis/shared/*": ["libraries/shared/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".turbo"]
}
